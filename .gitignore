# ==============================================================================
# 🌍 Global / OS / IDE
# ==============================================================================
node_modules/
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables (Never commit these!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Temporary/Output files from your tree
root_tree.txt

# ==============================================================================
# 🎨 Frontend (React / Vite)
# ==============================================================================
frontend/dist/
frontend/dist-ssr/
frontend/.eslintcache
frontend/coverage/

# ==============================================================================
# ⚙️ Server (Node.js / TypeScript)
# ==============================================================================
server/dist/
server/coverage/
server/.nyc_output/

# Assuming these are local testing/temp files based on your tree structure
server/ashu.json
server/node11.json
server/god_node.json
server/workflow.json

# ==============================================================================
# 🏗️ Terraform (terra/)
# ==============================================================================
# Local .terraform directories containing downloaded provider plugins
**/.terraform/*

# .tfstate files (Contains infrastructure state and highly sensitive data)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude .tfvars files (Usually contain sensitive variables/secrets)
*.tfvars
*.tfvars.json

# Ignore override files (Usually used for local testing)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore plan output files
*.tfplan

# CLI configuration files
.terraformrc
terraform.rc

# CRITICAL SECURITY: Ignore private SSH keys generated for instances
terra/terra_ed25519
*.pem

# ==============================================================================
# 🚢 Kubernetes (k8s/)
# ==============================================================================
# Ignore local secret backups/copies to prevent accidental credential leakage
k8s/raw_k8s/backend/secret_copy.yaml
# (Optional) If you want to blanket ignore all secrets and only commit templates:
# k8s/**/*secret*.yaml