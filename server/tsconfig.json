{
    "ts-node": {
        "files": true
    },
    "compilerOptions": {
        "target": "es6",
        "module": "commonjs",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "./server.ts",
        "types.d.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}