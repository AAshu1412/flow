    {
      "id": "JXD_pwbIOJeKJlgE9J_Fh",
      "type": "text",
      "x": -916.4069595811027,
      "y": 958.7469046758563,
      "width": 1765.1011962890625,
      "height": 535.6198929215136,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2C",
      "roundness": null,
      "seed": 1887550095,
      "version": 434,
      "versionNonce": 613594641,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1776085372074,
      "link": null,
      "locked": false,
      "text": "Program 1 handles onboarding miners by minting NFTs \nrepresenting their legal mining commitment along with BHRT\n tokens that represent their mining power. It also\n runs an Automated Market Maker (AMM) to\n facilitate the trading of BHRT tokens for USDC and also\n supports miners revoking their\n stake by burning tokens and returning mining power.",
      "fontSize": 61.21370204817299,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Program 1 handles onboarding miners by minting NFTs \nrepresenting their legal mining commitment along with BHRT\n tokens that represent their mining power. It also\n runs an Automated Market Maker (AMM) to\n facilitate the trading of BHRT tokens for USDC and also\n supports miners revoking their\n stake by burning tokens and returning mining power.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JGIoB4ibfpNq4SrMXsug3",
      "type": "text",
      "x": -6108.989326427112,
      "y": 1750.473288954631,
      "width": 2234.4026066706742,
      "height": 416.66666666666697,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2D",
      "roundness": null,
      "seed": 334280362,
      "version": 349,
      "versionNonce": 732442495,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1776085372074,
      "link": null,
      "locked": false,
      "text": "Program 2 manages vaults where users deposit BHRT tokens as \ncollateral to mint the stablecoin HST, enforcing over-\ncollateralization and risk controls. It also handles liquidation of\nunder-collateralized positions and debt settlement by burning\nstablecoins and releasing collateral",
      "fontSize": 66.66666666666671,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Program 2 manages vaults where users deposit BHRT tokens as \ncollateral to mint the stablecoin HST, enforcing over-collateralization and risk controls. It also handles liquidation of under-collateralized positions and debt settlement by burning stablecoins and releasing collateral",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "-B-DsnBEV4co4Z3E6DJXG",
